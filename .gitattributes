# Generated / machine-written artifacts must NEVER produce merge conflicts.
# They are rebuilt from source data on every run, so "keep ours" is always safe.
# Requires the local merge driver: git config merge.ours.driver true
# (auto-configured by git_safe_push.sh on every run).
docs/index.html      merge=ours
garmin/data.json     merge=ours
garmin/data.json.bak merge=ours
garmin/coach_note.md merge=ours
coach.log            merge=ours
garmin/.last_workout_push merge=ours
# context.json is human/AI-edited config; local edits are authoritative
# (GitHub Actions never writes it) — keep ours so an edit can't be lost to a merge.
context.json         merge=ours
